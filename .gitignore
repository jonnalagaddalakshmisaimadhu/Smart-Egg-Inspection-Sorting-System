# Python Virtual Environment
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Large Media & Raw Datasets (Keep data structure tracked via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/extracted/*
!data/extracted/.gitkeep
data/annotated/*
!data/annotated/.gitkeep
data/datasets/*
!data/datasets/.gitkeep

# Model weights and artifacts
models/weights/*.pt
models/weights/*.onnx
models/weights/*.engine
*.weights

# MLOps & Tracking
mlruns/
.dvc/cache/
.dvc/tmp/
runs/

# Environment Variables & Secrets
.env
.env.local

# IDE & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend Dependencies & Build Output
frontend/node_modules/
frontend/dist/
frontend/.next/
